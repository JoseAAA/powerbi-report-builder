model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Calendario", "Region", "Producto", "Ventas", "_ Medidas"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table Calendario
ref table Region
ref table Producto
ref table Ventas
ref table '_ Medidas'
