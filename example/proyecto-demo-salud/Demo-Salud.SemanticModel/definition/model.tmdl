model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Calendario", "Sede", "Servicio", "Indicador", "Indicadores", "_ Medidas"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table Calendario
ref table Sede
ref table Servicio
ref table Indicador
ref table Indicadores
ref table '_ Medidas'

ref expression RutaBase
