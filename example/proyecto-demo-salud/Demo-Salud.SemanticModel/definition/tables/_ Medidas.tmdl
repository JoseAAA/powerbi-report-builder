table '_ Medidas'
	isHidden
	lineageTag: 15b7d176-ae0b-412b-b378-28e3b2e98b6f

	/// Suma del numerador del indicador (columna Num del hecho). Medida base para construir cocientes; no se muestra sola.
	measure Numerador = ```
			VAR Resultado = SUM ( Indicadores[Num] )
			RETURN
			    Resultado
			```
		formatString: #,0
		displayFolder: Base
		isHidden
		lineageTag: 45b770db-2f9e-48c8-8ba0-4384da83f8bf

	/// Suma del denominador del indicador (columna Den del hecho). Medida base para construir cocientes; no se muestra sola.
	measure Denominador = ```
			VAR Resultado = SUM ( Indicadores[Den] )
			RETURN
			    Resultado
			```
		formatString: #,0
		displayFolder: Base
		isHidden
		lineageTag: e6a059d1-d28a-4d27-85b5-bd080dc18182

	/// Valor del indicador seleccionado (Numerador / Denominador). Devuelve BLANK si hay mas de un indicador en contexto, porque sumar indicadores distintos (un porcentaje y un importe) daria un numero sin significado. Segmenta por Indicador para verlo.
	measure 'Indicador %' = ```
			VAR UnSoloIndicador = HASONEVALUE ( Indicador[Indicador] )
			VAR Resultado = DIVIDE ( [Numerador], [Denominador] )
			RETURN
			    IF ( UnSoloIndicador, Resultado )
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Indicadores
		lineageTag: d590ddf8-21de-4f9d-81ee-87af82ba87d3

	/// % Ocupacion: indicador principal del reporte, filtrado explicitamente con CALCULATE. Muestra siempre un valor correcto aunque no haya segmentacion por Indicador.
	measure '% Ocupacion' = ```
			VAR Resultado =
			    CALCULATE (
			        DIVIDE ( [Numerador], [Denominador] ),
			        Indicador[Indicador] = "% Ocupacion"
			    )
			RETURN
			    Resultado
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Indicadores
		lineageTag: 0c0b52f3-ad29-4654-8c5a-51de338c2252

	column Valor
		isHidden
		formatString: 0
		lineageTag: f9624ff8-ff92-4816-a792-c794adc9b24c
		summarizeBy: none
		sourceColumn: [Valor]

		annotation SummarizationSetBy = Automatic

	partition '_ Medidas' = calculated
		mode: import
		source = ```
				SELECTCOLUMNS ( { BLANK() }, "Valor", BLANK() )
				```

	annotation PBI_ResultType = Calculated
