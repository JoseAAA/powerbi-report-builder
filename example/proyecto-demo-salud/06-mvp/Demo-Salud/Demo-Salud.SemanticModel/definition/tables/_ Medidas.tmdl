table '_ Medidas'
	isHidden
	lineageTag: a35a3c03-4b41-419c-805a-4aa4a0d4f1b3

	measure Numerador = ```
			VAR Resultado = SUM ( Indicadores[Num] )
			RETURN
			    Resultado
			```
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: a11cc1e2-6554-483c-a7a8-8c05dc01f9ee

	measure Denominador = ```
			VAR Resultado = SUM ( Indicadores[Den] )
			RETURN
			    Resultado
			```
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 7e01027a-1299-4569-8778-15c721a64c13

	measure 'Indicador %' = ```
			VAR Num = [Numerador]
			VAR Den = [Denominador]
			RETURN
			    DIVIDE ( Num, Den )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores
		lineageTag: dfd73f53-29c4-4808-8365-827ea458143c

	column Valor
		isHidden
